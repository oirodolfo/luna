{
  "name": "@rodkisten/luna",
  "version": "0.0.1",
  "description": "UI library",
  "main": "index.js",
  "bin": {
    "luna": "./bin/luna.js"
  },
  "scripts": {
    "clean": "rm -rf dist .storybook/out",
    "lint": "eslint \"src/share/*.{ts,js}\" \"*.js\" \"bin/*.js\" \"lib/*.js\" && luna lint",
    "typecheck": "tsc --noEmit",
    "check:no-licia": "! grep -R -n 'licia' src lib bin .storybook package.json package-lock.json pnpm-lock.yaml",
    "check:no-scss": "! find src -name '*.scss' | grep .",
    "build": "npm run clean && luna build",
    "test": "npm run build && luna test",
    "storybook": "storybook dev -p 8080",
    "build:storybook": "storybook build -o .storybook/out",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run check:no-licia && npm run check:no-scss && npm run build:storybook",
    "update": "luna update && lsla prettier \"*.json\" --write",
    "format": "lsla prettier \"src/share/*.{ts,tsx,js,css}\" \"*.{json,js,ts}\" \"bin/*.js\" \".storybook/*.{js,ts,css}\" \"lib/*.js\" --write && luna format",
    "genTheme": "lsla genTheme --input src/share/theme.json --output src/share/theme.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liriliri/luna.git"
  },
  "keywords": [
    "ui"
  ],
  "author": "redhoodsu",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/liriliri/luna/issues"
  },
  "homepage": "https://oirodolfo.github.io/luna/",
  "devDependencies": {
    "@babel/core": "^7.10.5",
    "@babel/preset-react": "^7.22.5",
    "@jsdevtools/coverage-istanbul-loader": "^3.0.5",
    "@storybook/addon-docs": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/html-webpack5": "^8.6.18",
    "@storybook/manager-api": "^8.6.18",
    "@storybook/theming": "^8.6.18",
    "@types/node": "^20.14.9",
    "@types/react": "^17.0.2",
    "@types/react-dom": "^17.0.2",
    "@typescript-eslint/eslint-plugin": "^5.13.0",
    "@typescript-eslint/parser": "^5.13.0",
    "@unocss/core": "^66.7.0",
    "@unocss/postcss": "^66.7.0",
    "autoprefixer": "^10.5.0",
    "babel-loader": "^9.2.1",
    "chai": "^4.2.0",
    "commander": "^9.3.0",
    "css-loader": "^7.1.4",
    "eslint": "^7.15.0",
    "eslint-config-prettier": "^7.0.0",
    "execa": "^4.0.0",
    "karma": "^5.2.3",
    "karma-chai": "^0.1.0",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage-istanbul-reporter": "^3.0.3",
    "karma-jquery": "^0.2.4",
    "karma-mocha": "^2.0.1",
    "karma-sourcemap-loader": "^0.3.8",
    "karma-webpack": "^4.0.2",
    "mini-css-extract-plugin": "^2.10.2",
    "mocha": "^8.2.1",
    "postcss": "^8.4.7",
    "postcss-clean": "^1.1.0",
    "postcss-loader": "^8.2.1",
    "postcss-prefixer": "^2.1.2",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "shelljs": "^0.8.3",
    "signal-exit": "^3.0.7",
    "storybook": "^8.6.18",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.0",
    "typedoc": "^0.26.3",
    "typescript": "^4.8.3",
    "unocss": "^66.7.0",
    "vue": "^3.5.4",
    "webpack": "^5.107.2",
    "webpack-bundle-analyzer": "^4.4.2",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "jsmediatags": "^3.9.7",
    "markdown-it": "^14.2.0",
    "micromark": "^4.0.2",
    "stat-mode": "^1.0.0",
    "wavesurfer.js": "^7.12.7"
  },
  "packageManager": "pnpm@9.15.9"
}
